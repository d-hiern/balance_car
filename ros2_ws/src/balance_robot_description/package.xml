<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>balance_robot_description</name>
  <version>1.0.0</version>
  <description>
    URDF/Xacro description cho xe cân bằng hai bánh (self-balancing robot).
    Bao gồm 2 động cơ bước NEMA17, cảm biến IMU MPU6050, ESP32,
    2x A4988 motor driver, mạch giảm áp LM2596, và khung pin 18650.
    Hỗ trợ mô phỏng Gazebo với ROS2 Foxy.
  </description>

  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher</exec_depend>
  <exec_depend>joint_state_publisher_gui</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
