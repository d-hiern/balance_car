<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="balance_robot">
  <!--
    =================================================================
    Xe Cân Bằng Hai Bánh (Self-Balancing Robot)
    URDF/Xacro cho ROS2 Foxy + Gazebo 11
    =================================================================
    Cấu trúc robot:
      - Tầng 2 (trên cùng): Khung pin + pin 18650
      - Tầng 1 (giữa):      Bảng mạch PCB chứa ESP32, MPU6050,
                              2x A4988 Driver, Mạch giảm áp LM2596
      - Đế   (dưới cùng):   Tấm mica + 2 động cơ bước NEMA17 + 2 bánh xe

    Tổng khối lượng ước tính: ~0.93 kg
    =================================================================
  -->

  <!-- ============================================================ -->
  <!--                     THÔNG SỐ ROBOT (Properties)              -->
  <!-- ============================================================ -->

  <!-- Tấm mica (Base Plate) - 150mm x 100mm x 3mm -->
  <xacro:property name="base_length"    value="0.150"/>
  <xacro:property name="base_width"     value="0.100"/>
  <xacro:property name="base_thickness" value="0.003"/>
  <xacro:property name="base_mass"      value="0.055"/>

  <!-- Động cơ bước NEMA17 (Stepper Motor) - 42mm x 42mm x 40mm -->
  <xacro:property name="motor_face"  value="0.042"/>
  <xacro:property name="motor_depth" value="0.040"/>
  <xacro:property name="motor_mass"  value="0.280"/>

  <!-- Bánh xe cao su (Rubber Wheels) - đường kính 65mm, rộng 26mm -->
  <xacro:property name="wheel_radius" value="0.0325"/>
  <xacro:property name="wheel_width"  value="0.026"/>
  <xacro:property name="wheel_mass"   value="0.035"/>

  <!-- Trụ đỡ tầng 1 (Layer 1 Standoffs) - cao 40mm, đường kính 6mm -->
  <xacro:property name="standoff1_height" value="0.040"/>
  <xacro:property name="standoff_radius"  value="0.003"/>
  <xacro:property name="standoff_mass"    value="0.005"/>

  <!-- Trụ đỡ tầng 2 (Layer 2 Standoffs) - cao 35mm -->
  <xacro:property name="standoff2_height" value="0.035"/>

  <!-- Bảng mạch PCB + toàn bộ linh kiện (Layer 1) -->
  <!--   PCB=30g + ESP32=10g + MPU6050=3g + 2xA4988=30g + LM2596=12g = 85g -->
  <xacro:property name="pcb_length"       value="0.100"/>
  <xacro:property name="pcb_width"        value="0.080"/>
  <xacro:property name="pcb_thickness"    value="0.0016"/>
  <xacro:property name="electronics_mass" value="0.085"/>

  <!-- Khung pin + 2x Pin 18650 (Battery - Layer 2) -->
  <xacro:property name="battery_length" value="0.075"/>
  <xacro:property name="battery_width"  value="0.060"/>
  <xacro:property name="battery_height" value="0.022"/>
  <xacro:property name="battery_mass"   value="0.120"/>

  <!-- ============ Giá trị tính toán (Derived values) ============ -->
  <xacro:property name="motor_z" value="${-(base_thickness/2 + motor_face/2)}"/>
  <xacro:property name="wheel_y_gap"        value="0.002"/>
  <xacro:property name="wheel_y_from_motor" value="${motor_depth/2 + wheel_width/2 + wheel_y_gap}"/>
  <xacro:property name="layer1_z"          value="${base_thickness/2 + standoff1_height + pcb_thickness/2}"/>
  <xacro:property name="layer2_z_from_pcb" value="${pcb_thickness/2 + standoff2_height + battery_height/2}"/>
  <xacro:property name="wheel_track" value="${2*(base_width/2 + wheel_y_from_motor)}"/>
  <xacro:property name="ground_clearance" value="${base_thickness/2 + motor_face/2 + wheel_radius}"/>


  <!-- ============================================================ -->
  <!--                      MÀU SẮC (Materials)                    -->
  <!-- ============================================================ -->

  <material name="mica_clear_blue">
    <color rgba="0.6 0.85 1.0 0.7"/>
  </material>
  <material name="motor_dark_gray">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="wheel_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="pcb_green">
    <color rgba="0.0 0.45 0.15 1.0"/>
  </material>
  <material name="esp32_navy">
    <color rgba="0.05 0.12 0.45 1.0"/>
  </material>
  <material name="component_gray">
    <color rgba="0.35 0.35 0.35 1.0"/>
  </material>
  <material name="driver_red">
    <color rgba="0.7 0.1 0.1 1.0"/>
  </material>
  <material name="battery_blue">
    <color rgba="0.15 0.25 0.65 1.0"/>
  </material>
  <material name="standoff_silver">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="buck_dark">
    <color rgba="0.15 0.15 0.2 1.0"/>
  </material>


  <!-- ============================================================ -->
  <!--                   MACRO QUÁN TÍNH (Inertia)                  -->
  <!-- ============================================================ -->

  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(y*y+z*z)}" ixy="0.0" ixz="0.0"
               iyy="${m/12*(x*x+z*z)}" iyz="0.0"
               izz="${m/12*(x*x+y*y)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
               iyy="${m*r*r/2}"           iyz="0.0"
               izz="${m/12*(3*r*r+h*h)}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="cylinder_inertia_z" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12*(3*r*r+h*h)}" ixy="0.0" ixz="0.0"
               iyy="${m/12*(3*r*r+h*h)}" iyz="0.0"
               izz="${m*r*r/2}"/>
    </inertial>
  </xacro:macro>


  <!-- ============================================================ -->
  <!--             MACRO CỤM BÁNH XE (Wheel Assembly)              -->
  <!-- ============================================================ -->

  <xacro:macro name="wheel_assembly" params="side reflect">

    <!-- Motor Link (Thân động cơ bước NEMA17) -->
    <link name="${side}_motor_link">
      <visual>
        <geometry>
          <box size="${motor_face} ${motor_depth} ${motor_face}"/>
        </geometry>
        <material name="motor_dark_gray"/>
      </visual>
      <collision>
        <geometry>
          <box size="${motor_face} ${motor_depth} ${motor_face}"/>
        </geometry>
      </collision>
      <xacro:box_inertia m="${motor_mass}"
                          x="${motor_face}" y="${motor_depth}" z="${motor_face}"/>
    </link>

    <joint name="${side}_motor_joint" type="fixed">
      <parent link="base_link"/>
      <child  link="${side}_motor_link"/>
      <origin xyz="0 ${reflect * base_width/2} ${motor_z}" rpy="0 0 0"/>
    </joint>

    <!-- Wheel Link (Bánh xe cao su) -->
    <link name="${side}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="wheel_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}"/>
    </link>

    <joint name="${side}_wheel_joint" type="continuous">
      <parent link="${side}_motor_link"/>
      <child  link="${side}_wheel_link"/>
      <origin xyz="0 ${reflect * wheel_y_from_motor} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.005" friction="0.05"/>
    </joint>

    <!-- Gazebo: thuộc tính vật lý bánh xe -->
    <gazebo reference="${side}_wheel_link">
      <mu1>1.5</mu1>
      <mu2>1.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <material>Gazebo/DarkGrey</material>
    </gazebo>

    <gazebo reference="${side}_motor_link">
      <material>Gazebo/Grey</material>
    </gazebo>

  </xacro:macro>


  <!-- ============================================================ -->
  <!--                 MACRO TRỤ ĐỠ (Standoff)                     -->
  <!-- ============================================================ -->

  <xacro:macro name="standoff_link" params="name parent_link px py pz height">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="${standoff_radius}" length="${height}"/>
        </geometry>
        <material name="standoff_silver"/>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="${standoff_radius}" length="${height}"/>
        </geometry>
      </collision>
      <xacro:cylinder_inertia_z m="${standoff_mass}" r="${standoff_radius}" h="${height}"/>
    </link>
    <joint name="${name}_joint" type="fixed">
      <parent link="${parent_link}"/>
      <child  link="${name}"/>
      <origin xyz="${px} ${py} ${pz}" rpy="0 0 0"/>
    </joint>
    <gazebo reference="${name}">
      <material>Gazebo/Grey</material>
    </gazebo>
  </xacro:macro>


  <!-- ============================================================ -->
  <!--                      THÂN ROBOT (Body)                       -->
  <!-- ============================================================ -->

  <!-- ====== ĐẾ: BASE LINK (Tấm mica) ====== -->
  <link name="base_link">
    <visual>
      <geometry>
        <box size="${base_length} ${base_width} ${base_thickness}"/>
      </geometry>
      <material name="mica_clear_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${base_length} ${base_width} ${base_thickness}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}"
                        x="${base_length}" y="${base_width}" z="${base_thickness}"/>
  </link>

  <gazebo reference="base_link">
    <material>Gazebo/BlueTransparent</material>
  </gazebo>


  <!-- ====== CỤM BÁNH XE TRÁI VÀ PHẢI ====== -->
  <xacro:wheel_assembly side="left"  reflect="1"/>
  <xacro:wheel_assembly side="right" reflect="-1"/>


  <!-- ====== TRỤ ĐỠ TẦNG 1 (4 trụ từ đế lên PCB) ====== -->
  <xacro:property name="so1_x" value="${pcb_length/2 - 0.005}"/>
  <xacro:property name="so1_y" value="${pcb_width/2  - 0.005}"/>
  <xacro:property name="so1_z" value="${base_thickness/2 + standoff1_height/2}"/>

  <xacro:standoff_link name="standoff_l1_fl" parent_link="base_link"
      px="${so1_x}"  py="${so1_y}"  pz="${so1_z}" height="${standoff1_height}"/>
  <xacro:standoff_link name="standoff_l1_fr" parent_link="base_link"
      px="${so1_x}"  py="${-so1_y}" pz="${so1_z}" height="${standoff1_height}"/>
  <xacro:standoff_link name="standoff_l1_bl" parent_link="base_link"
      px="${-so1_x}" py="${so1_y}"  pz="${so1_z}" height="${standoff1_height}"/>
  <xacro:standoff_link name="standoff_l1_br" parent_link="base_link"
      px="${-so1_x}" py="${-so1_y}" pz="${so1_z}" height="${standoff1_height}"/>


  <!-- ====== TẦNG 1: PCB + LINH KIỆN ĐIỆN TỬ ====== -->
  <link name="pcb_link">
    <!-- Bảng đồng PCB -->
    <visual>
      <geometry>
        <box size="${pcb_length} ${pcb_width} ${pcb_thickness}"/>
      </geometry>
      <material name="pcb_green"/>
    </visual>

    <!-- ESP32 DevKit Module (~51mm x 26mm x 12mm) -->
    <visual>
      <origin xyz="-0.015 0.020 ${pcb_thickness/2 + 0.006}" rpy="0 0 0"/>
      <geometry>
        <box size="0.051 0.026 0.012"/>
      </geometry>
      <material name="esp32_navy"/>
    </visual>

    <!-- MPU6050 Breakout Board (~21mm x 16mm x 3mm) -->
    <visual>
      <origin xyz="0.030 0.020 ${pcb_thickness/2 + 0.0015}" rpy="0 0 0"/>
      <geometry>
        <box size="0.021 0.016 0.003"/>
      </geometry>
      <material name="component_gray"/>
    </visual>

    <!-- Mạch điều khiển động cơ 1 - A4988 (~20mm x 15mm x 15mm) -->
    <visual>
      <origin xyz="-0.025 -0.022 ${pcb_thickness/2 + 0.0075}" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.015 0.015"/>
      </geometry>
      <material name="driver_red"/>
    </visual>

    <!-- Mạch điều khiển động cơ 2 - A4988 (~20mm x 15mm x 15mm) -->
    <visual>
      <origin xyz="0.025 -0.022 ${pcb_thickness/2 + 0.0075}" rpy="0 0 0"/>
      <geometry>
        <box size="0.020 0.015 0.015"/>
      </geometry>
      <material name="driver_red"/>
    </visual>

    <!-- Mạch giảm áp LM2596 (~43mm x 21mm x 13mm) -->
    <visual>
      <origin xyz="0.000 -0.003 ${pcb_thickness/2 + 0.0065}" rpy="0 0 0"/>
      <geometry>
        <box size="0.043 0.021 0.013"/>
      </geometry>
      <material name="buck_dark"/>
    </visual>

    <!-- Collision đơn giản -->
    <collision>
      <origin xyz="0 0 0.009" rpy="0 0 0"/>
      <geometry>
        <box size="${pcb_length} ${pcb_width} 0.022"/>
      </geometry>
    </collision>

    <xacro:box_inertia m="${electronics_mass}"
                        x="${pcb_length}" y="${pcb_width}" z="0.022"/>
  </link>

  <joint name="pcb_joint" type="fixed">
    <parent link="base_link"/>
    <child  link="pcb_link"/>
    <origin xyz="0 0 ${layer1_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="pcb_link">
    <material>Gazebo/Green</material>
  </gazebo>


  <!-- ====== IMU LINK (Khung tọa độ cảm biến MPU6050) ====== -->
  <link name="imu_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.0000001" ixy="0.0" ixz="0.0"
               iyy="0.0000001" iyz="0.0"
               izz="0.0000001"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="pcb_link"/>
    <child  link="imu_link"/>
    <origin xyz="0.030 0.020 ${pcb_thickness/2 + 0.003}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>


  <!-- ====== TRỤ ĐỠ TẦNG 2 (4 trụ từ PCB lên khung pin) ====== -->
  <xacro:property name="so2_x" value="${battery_length/2 - 0.005}"/>
  <xacro:property name="so2_y" value="${battery_width/2  - 0.005}"/>
  <xacro:property name="so2_z" value="${pcb_thickness/2 + standoff2_height/2}"/>

  <xacro:standoff_link name="standoff_l2_fl" parent_link="pcb_link"
      px="${so2_x}"  py="${so2_y}"  pz="${so2_z}" height="${standoff2_height}"/>
  <xacro:standoff_link name="standoff_l2_fr" parent_link="pcb_link"
      px="${so2_x}"  py="${-so2_y}" pz="${so2_z}" height="${standoff2_height}"/>
  <xacro:standoff_link name="standoff_l2_bl" parent_link="pcb_link"
      px="${-so2_x}" py="${so2_y}"  pz="${so2_z}" height="${standoff2_height}"/>
  <xacro:standoff_link name="standoff_l2_br" parent_link="pcb_link"
      px="${-so2_x}" py="${-so2_y}" pz="${so2_z}" height="${standoff2_height}"/>


  <!-- ====== TẦNG 2: KHUNG PIN + PIN 18650 ====== -->
  <link name="battery_link">
    <visual>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
      <material name="battery_blue"/>
    </visual>
    <collision>
      <geometry>
        <box size="${battery_length} ${battery_width} ${battery_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${battery_mass}"
                        x="${battery_length}" y="${battery_width}" z="${battery_height}"/>
  </link>

  <joint name="battery_joint" type="fixed">
    <parent link="pcb_link"/>
    <child  link="battery_link"/>
    <origin xyz="0 0 ${layer2_z_from_pcb}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="battery_link">
    <material>Gazebo/Blue</material>
  </gazebo>


  <!-- ============================================================ -->
  <!--                  GAZEBO PLUGINS (ROS2 Foxy)                  -->
  <!-- ============================================================ -->

  <!--
    CẢM BIẾN IMU (MPU6050)
    Topic xuất: /imu/data  (sensor_msgs/msg/Imu)
    Tần số: 100 Hz
  -->
  <gazebo reference="imu_link">
    <gravity>true</gravity>
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=imu/data</remapping>
        </ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
      </plugin>
    </sensor>
  </gazebo>

  <!--
    ĐIỀU KHIỂN DIFFERENTIAL DRIVE (2 Động cơ bước)
    Topic nhận lệnh: /cmd_vel  (geometry_msgs/msg/Twist)
    Topic xuất:       /odom     (nav_msgs/msg/Odometry)
  -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
      </ros>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_track}</wheel_separation>
      <wheel_diameter>${2*wheel_radius}</wheel_diameter>
      <max_wheel_torque>5.0</max_wheel_torque>
      <max_wheel_acceleration>30.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <command_topic>cmd_vel</command_topic>
      <odometry_topic>odom</odometry_topic>
    </plugin>
  </gazebo>

  <!--
    JOINT STATE PUBLISHER
    Topic xuất: /joint_states  (sensor_msgs/msg/JointState)
  -->
  <gazebo>
    <plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
      <ros>
        <namespace>/</namespace>
        <remapping>~/out:=joint_states</remapping>
      </ros>
      <update_rate>50</update_rate>
      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>
    </plugin>
  </gazebo>

</robot>
