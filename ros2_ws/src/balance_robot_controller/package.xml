<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>balance_robot_controller</name>
  <version>1.0.0</version>
  <description>
    Bộ điều khiển PID cho xe cân bằng hai bánh (self-balancing robot).
    Bao gồm:
    - PID balance controller (đọc IMU, xuất cmd_vel)
    - PID auto-tuner (relay feedback + Ziegler-Nichols)
    - Hỗ trợ runtime parameter tuning
  </description>

  <maintainer email="user@todo.todo">user</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
